    subStatus    = "",
    DWELL_TIME   = 1.5,   -- giây đứng trên ticket
    ANTI_RADIUS  = 20,    -- khoảng cách phát hiện player (stud)
    ESCAPE_MIN   = 30,    -- khoảng cách TP tối thiểu khi né bot
    ESCAPE_MAX   = 40,    -- khoảng cách TP tối đa khi né bot
}

-- ══════════════════════════════════════════════════════════════
-- HELPERS
-- ══════════════════════════════════════════════════════════════

local function getHRP(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getTicketPosition(model)
    local h  = model:FindFirstChild("HumanoidRootPart")
    if h  then return h.Position end
    local pp = model.PrimaryPart
    if pp then return pp.Position end
    local bp = model:FindFirstChildWhichIsA("BasePart")
    if bp then return bp.Position end
    return nil
end

local function getActiveTickets()
    local folder = workspace:FindFirstChild("Game")
        and workspace.Game:FindFirstChild("Effects")
        and workspace.Game.Effects:FindFirstChild("Tickets")
    if not folder then return {} end
    local list = {}
    for _, model in pairs(folder:GetChildren()) do
        if model:IsA("Model") then
            local pos = getTicketPosition(model)
            if pos then
                table.insert(list, { model = model, position = pos })
            end
        end
    end
    return list
end


-- ── Cache NPC names từ ReplicatedStorage → NPCs (1 lần, event-driven) ──
local npcNameCache = {}
do
    local npcFolder = game:GetService("ReplicatedStorage"):FindFirstChild("NPCs")
    if npcFolder then
        for _, obj in pairs(npcFolder:GetChildren()) do
            npcNameCache[obj.Name] = true
        end
        npcFolder.ChildAdded:Connect(function(obj)
            npcNameCache[obj.Name] = true
        end)
        npcFolder.ChildRemoved:Connect(function(obj)
            npcNameCache[obj.Name] = nil
        end)
    end
end

-- ── Lấy vị trí 1 model trong Workspace.Game.Players ──────────
local function getModelPos(model)
    local h  = model:FindFirstChild("HumanoidRootPart")
    if h  then return h.Position end
    local pp = model.PrimaryPart
    if pp then return pp.Position end
    local bp = model:FindFirstChildWhichIsA("BasePart")
    if bp then return bp.Position end
    return nil
end

-- ── Tìm Bee trong Workspace → Game → Players ─────────────────
local function findBeeInWorld()
    local folder = workspace:FindFirstChild("Game")
        and workspace.Game:FindFirstChild("Players")
    if not folder then return nil end
    for _, model in pairs(folder:GetChildren()) do
        if model.Name == "Bee" then
            local pos = getModelPos(model)
            if pos then return pos end
        end
    end
    return nil
end

-- ── Tìm bot gần nhất khớp NPC list (trừ Bee) ─────────────────
local function getNearestBot(myPos)
    local folder = workspace:FindFirstChild("Game")
        and workspace.Game:FindFirstChild("Players")
    if not folder then return nil end

    local closest, closestDist = nil, math.huge

    for _, model in pairs(folder:GetChildren()) do
        if model.Name == "Bee" then continue end
        if not npcNameCache[model.Name] then continue end
        local pos = getModelPos(model)
        if not pos then continue end
        local d = (pos - myPos).Magnitude
        if d < farm.ANTI_RADIUS and d < closestDist then
            closestDist = d
            closest     = pos
        end
    end
    return closest
end

-- Safe TP
local function tpTo(pos)
    local c = player.Character
    local h = getHRP(c)
    if not h then return false end
    pcall(function()
        h.CFrame = CFrame.new(pos)
        h.AssemblyLinearVelocity = Vector3.zero
    end)
    return true
end

-- ══════════════════════════════════════════════════════════════
-- ANTI-PLAYER LOOP (chạy song song)
-- ══════════════════════════════════════════════════════════════
local function startAntiPlayer()
    if farm.antiConn then
        pcall(function() task.cancel(farm.antiConn) end)
    end
    farm.antiConn = task.spawn(function()
        while farm.enabled do
            task.wait(0.15)
            local c = player.Character
            local h = getHRP(c)
            if not h then continue end

            local myPos  = h.Position
            local beePos = findBeeInWorld()

            -- Ưu tiên 1: Bee xuất hiện trong Workspace.Game.Players → TP thẳng đến Bee
            if beePos then
                tpTo(beePos + Vector3.new(0, 2, 0))
                farm.subStatus = "BEE detected → TPed to Bee"
                continue
            end

            -- Ưu tiên 2: Bot trong NPC list tiến gần → TP ngẫu nhiên xung quanh
            --            liên tục đến khi không còn bot nào gần nữa
            local botPos = getNearestBot(myPos)
            if botPos then
                local angle = math.random() * 2 * math.pi
                local dist  = farm.ESCAPE_MIN
                            + math.random() * (farm.ESCAPE_MAX - farm.ESCAPE_MIN)
                local offset = Vector3.new(
                    math.cos(angle) * dist,
                    0,
                    math.sin(angle) * dist
                )
                tpTo(botPos + offset)
                farm.subStatus = "Bot nearby → evading..."
            else
                farm.subStatus = ""
            end
        end
    end)
end

-- ══════════════════════════════════════════════════════════════
-- TICKET FARM LOOP
-- ══════════════════════════════════════════════════════════════
local function startTicketFarm()
    local c = player.Character
    local h = getHRP(c)
    if not h then
        farm.status = "No character!"
        return
    end

    farm.count  = 0
    farm.status = "Scanning..."

    if farm.workerConn then
        pcall(function() task.cancel(farm.workerConn) end)
    end

    startAntiPlayer()

    farm.workerConn = task.spawn(function()
        while farm.enabled do
            task.wait(0.3)

            local c2 = player.Character
            local h2 = getHRP(c2)
            if not h2 then continue end

            -- Nếu đang bị anti-player xử lý (có Bee / enemy) thì chờ
            if farm.subStatus ~= "" then
                farm.status = "⏸ " .. farm.subStatus
                task.wait(0.5)
                continue
            end

            local tickets = getActiveTickets()

            if #tickets == 0 then
                farm.status = "⏳ Waiting for tickets... | Total: " .. farm.count
                continue
            end

            farm.status = "🎫 " .. #tickets .. " ticket(s) found!"

            local myPos = h2.Position
            table.sort(tickets, function(a, b)
                return (a.position - myPos).Magnitude < (b.position - myPos).Magnitude
            end)

            for _, t in pairs(tickets) do
                if not farm.enabled then break end
                if not t.model or not t.model.Parent then continue end

                -- Nếu anti-player đang hoạt động thì dừng collect tạm thời
                if farm.subStatus ~= "" then break end

                local pos = getTicketPosition(t.model)
                if not pos then continue end

                farm.status = "⚡ TP to ticket..."
                tpTo(pos + Vector3.new(0, 2, 0))

                farm.status = "⏳ Collecting..."
                task.wait(farm.DWELL_TIME)

                if not t.model or not t.model.Parent then
                    farm.count  = farm.count + 1
                    farm.status = "✓ Collected! Total: " .. farm.count
                end
            end
        end

        farm.status = "Stopped | Total: " .. farm.count
    end)
end

-- ══════════════════════════════════════════════════════════════
-- STOP ALL
-- ══════════════════════════════════════════════════════════════
local function stopAll()
    farm.enabled = false
    if farm.workerConn then
        pcall(function() task.cancel(farm.workerConn) end)
        farm.workerConn = nil
    end
    if farm.antiConn then
        pcall(function() task.cancel(farm.antiConn) end)
        farm.antiConn = nil
    end
    farm.status    = "Idle"
    farm.subStatus = ""
end

